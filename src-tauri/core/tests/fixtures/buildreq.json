{
  "fixedNowMs": 1700000000000,
  "floats": [
    0,
    0.5,
    0.999,
    0.123456,
    0.7
  ],
  "cases": [
    {
      "name": "bearer",
      "expected": {
        "request": {
          "method": "GET",
          "url": "https://x.example/u",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer TOK"
            }
          ]
        }
      }
    },
    {
      "name": "apikey_header",
      "expected": {
        "request": {
          "method": "GET",
          "url": "https://x.example/u",
          "header": [
            {
              "key": "X-API-Key",
              "value": "AK"
            }
          ]
        }
      }
    },
    {
      "name": "apikey_query",
      "expected": {
        "request": {
          "method": "GET",
          "url": "https://x.example/u?X-API-Key=AK",
          "header": []
        }
      }
    },
    {
      "name": "apikey_header_template_key",
      "expected": {
        "request": {
          "method": "GET",
          "url": "https://x.example/u",
          "header": [
            {
              "key": "X-Tenant-Token",
              "value": "AK"
            }
          ]
        }
      }
    },
    {
      "name": "apikey_query_template_key",
      "expected": {
        "request": {
          "method": "GET",
          "url": "https://x.example/u?api_key=AK",
          "header": []
        }
      }
    },
    {
      "name": "basic",
      "expected": {
        "request": {
          "method": "GET",
          "url": "https://x.example/u",
          "header": [
            {
              "key": "Authorization",
              "value": "Basic dTpw"
            }
          ]
        }
      }
    },
    {
      "name": "query_enc",
      "expected": {
        "request": {
          "method": "GET",
          "url": "https://x.example/s?q=a%20b%26c",
          "header": []
        }
      }
    },
    {
      "name": "json_body",
      "expected": {
        "request": {
          "method": "POST",
          "url": "https://x.example/u",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\"a\":1}"
          }
        }
      }
    },
    {
      "name": "timestamp_query",
      "expected": {
        "request": {
          "method": "GET",
          "url": "https://x.example/u?t=1700000000",
          "header": []
        }
      }
    }
  ]
}
