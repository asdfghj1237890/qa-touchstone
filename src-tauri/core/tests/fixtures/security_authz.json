  ],
  "outcome": [
    {
      "name": "ok200",
      "status": 200,
      "expected": "allowed"
    },
    {
      "name": "denied403",
      "status": 403,
      "expected": "denied"
    },
    {
      "name": "notfound404",
      "status": 404,
      "expected": "denied"
    },
    {
      "name": "server500",
      "status": 500,
      "expected": "other"
