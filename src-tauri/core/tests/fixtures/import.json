{
  "postman": {
    "collection": {
      "name": "Pet Store",
      "source": "postman",
      "base_url": null
    },
    "folders": [
      {
        "name": "Pet Store",
        "requests": [
          {
            "method": "GET",
            "name": "List Pets",
            "path": "https://api.pets.io/v1/pets?limit=10",
