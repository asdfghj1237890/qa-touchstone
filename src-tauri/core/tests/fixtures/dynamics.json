{
  "fixedNowMs": 1700000000000,
  "floats": [
    0,
    0.5,
    0.999,
    0.123456,
    0.7
  ],
  "cases": [
    {
      "name": "$timestamp",
      "text": "{{$timestamp}}",
      "expected": "1700000000"
    },
    {
      "name": "$isoTimestamp",
      "text": "{{$isoTimestamp}}",
      "expected": "2023-11-14T22:13:20.000Z"
    },
    {
      "name": "$randomInt",
      "text": "{{$randomInt}}",
      "expected": "0"
    },
    {
      "name": "$guid",
      "text": "{{$guid}}",
      "expected": "08f1b08f-1b08-4f1b-88f1-b08f1b08f1b0"
    },
    {
      "name": "$randomEmail",
      "text": "{{$randomEmail}}",
      "expected": "user0@acme.dev"
    }
  ]
}
