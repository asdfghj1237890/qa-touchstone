{
  "name": "qa-touchstone",
  "version": "0.20.0",
  "private": true,
  "description": "A local-first, Postman-compatible desktop workspace for API QA — REST/GraphQL client, collection runner, k6 performance testing, security testing (RBAC/BOLA/rate-limit) with CI-ready reports, realtime (WS/SSE), and AI assistance.",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "setup:k6": "node scripts/setup-k6.mjs",
    "setup:k6:release": "node scripts/setup-k6.mjs --release",
    "pretauri:dev": "node scripts/setup-k6.mjs",
    "tauri:dev": "tauri dev",
    "pretauri:build": "node scripts/setup-k6.mjs --release",
    "tauri:build": "tauri build",
    "icons": "node scripts/gen-icons.mjs && tauri icon src-tauri/icons/source.png && node scripts/gen-favicon.mjs",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --coverage.reporter=html --coverage.reporter=text --coverage.reportOnFailure",
    "test:html": "vitest run --reporter=html",
    "test:html-view": "(npm run test:html || true) && node scripts/generate-test-index.js && npx vite preview --outDir src/__tests__/test-report --open",
    "test:coverage-view": "(npm run test:coverage || true) && npx vite preview --outDir src/__tests__/test-report/coverage --open",
    "test:safe": "vitest run || true",
    "clean": "rm -rf node_modules/.cache && rm -rf build"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@mui/x-data-grid": "^8.5.1",
    "@mui/x-tree-view": "^8.5.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "dompurify": "^3.4.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-class-properties": "^7.24.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.24.7",
    "@babel/plugin-transform-optional-chaining": "^7.24.8",
    "@babel/plugin-transform-private-methods": "^7.24.7",
    "@babel/plugin-transform-private-property-in-object": "^7.24.7",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.2.2",
    "@vitest/ui": "^3.2.2",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.1.0",
    "png-to-ico": "^3.0.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  },
  "author": "unuwayne",
  "license": "ISC",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": ">=2.0.1",
    "postcss": ">=8.4.31",
    "svgo": ">=2.0.0",
    "css-select": ">=4.0.0"
  }
}
