{
  "name": "qa-touchstone-e2e",
  "private": true,
  "type": "module",
  "description": "Desktop E2E smoke harness (WebdriverIO + tauri-driver). Isolated from the root package so the heavy WDIO tree stays out of the app lockfile and audit surface. See README.md.",
  "scripts": {
    "test": "wdio run ./wdio.conf.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "fast-xml-parser": "^5.10.1",
    "brace-expansion": "^2.1.3",
    "ip-address": "^10.4.0",
    "@puppeteer/browsers": "^3.2.1",
    "deepmerge-ts": "^8.0.1",
    "undici@6": "^6.28.0",
    "undici@7": "^7.29.0",
    "minimatch@3": {
      "brace-expansion": "^1.1.17"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    }
  }
}
