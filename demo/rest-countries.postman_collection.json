{
  "info": {
    "name": "OpenNet REST Countries \u2014 QA Touchstone Collection",
    "description": "Supplemental API collection for the OpenNet AQA RestAPI homework. The Python pytest suite remains the source of truth; this Postman-compatible collection mirrors the same positive/negative REST Countries checks so QA Touchstone can be used for quick smoke/exploratory reruns. Base URL: https://restcountries.com/v3.1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC1 Search country by name \u2014 positive",
      "item": [
        {
          "name": "Search name: japan -> Japan/Tokyo/Asia",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "https://restcountries.com/v3.1/name/japan?fields=name,capital,region,cca2",
            "description": "Expected: 200, non-empty list, Japan record has capital Tokyo and region Asia."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"response is a non-empty list\", function () { pm.expect(body).to.be.an('array').that.is.not.empty; });",
                  "pm.test(\"includes Japan\", function () { const match = body.find(c => c.name && c.name.common === \"Japan\"); pm.expect(match, 'matched country').to.exist; pm.expect(match.capital).to.deep.equal([\"Tokyo\"]); pm.expect(match.region).to.equal(\"Asia\"); });"
                ]
              }
            }
          ]
        },
